{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "port": { "type": "integer" }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "clusterId": { "type": "string" },
        "tenantId": { "type": "string" },
        "lokiEnabled": { "type": "boolean" },
        "lokiUrl": { "type": "string" },
        "lokiLookbackMinutes": { "type": "integer", "minimum": 1 },
        "lokiMaxLogLines": { "type": "integer", "minimum": 1 },
        "prometheusUrl": { "type": "string" },
        "prometheusLookbackMinutes": { "type": "integer", "minimum": 1 },
        "prometheusEnabled": { "type": "boolean" },
        "grafanaBaseUrl": { "type": "string" },
        "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "redactLogStats": { "type": "boolean" },
        "redactExtraPatterns": { "type": "string" }
      },
      "required": ["clusterId"]
    },
    "auth": {
      "type": "object",
      "properties": {
        "vendorCABundle": { "type": "string" },
        "renewCron": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "schedule": { "type": "string" },
            "renewBefore": {
              "type": "string",
              "description": "Skip renewal if the current cert has more than this much validity left. Go duration (e.g. \"48h\", \"12h\"). Empty or \"0\" disables the check.",
              "pattern": "^(0|[0-9]+(ns|us|µs|ms|s|m|h))+$"
            },
            "resources": { "type": "object" }
          }
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "secretStoreName": { "type": "string" },
        "secretStoreKind": { "type": "string" },
        "remoteSecretPath": { "type": "string" },
        "refreshInterval": { "type": "string" },
        "centralAgentUrlProperty": { "type": "string" },
        "bootstrapTokenProperty": { "type": "string" }
      }
    },
    "devSecrets": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "centralAgentUrl": { "type": "string" },
        "bootstrapToken": { "type": "string" }
      }
    },
    "resources": { "type": "object" }
  }
}
